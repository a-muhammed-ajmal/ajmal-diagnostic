# Copy this file to .env.local and fill in the real values.
#
#   NEXT_PUBLIC_* values are inlined into the client bundle at build time — never put a
#   secret behind that prefix. Everything else is server-only and read lazily inside
#   route handlers, so the build does not require it.
#
# Deployed builds read these from the Vercel project environment variables instead.


# ---------------------------------------------------------------------------
# REQUIRED — the build fails without it
# ---------------------------------------------------------------------------

# Every booking CTA on the site depends on this: the /contact popup, the /results CTA,
# and the button in the diagnostic report email. Validated in next.config.ts (before
# compilation) and again in src/lib/env.ts. Must be an https://calendly.com/... URL
# with an event path — the bare domain is rejected.
NEXT_PUBLIC_CALENDLY_LINK=https://calendly.com/your-handle/30min


# ---------------------------------------------------------------------------
# Public — inlined into the client bundle
# ---------------------------------------------------------------------------

# Canonical origin for the sitemap, admin redirects and the proxy's allowed origins.
# Falls back to a hardcoded value where unset.
NEXT_PUBLIC_SITE_URL=https://www.muhammedajmal.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ---------------------------------------------------------------------------
# Server-only — never exposed to the browser
# ---------------------------------------------------------------------------

# Bypasses RLS. Route handlers and Server Components only.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (diagnostic report, contact notification).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Diagnostic report generation.
ANTHROPIC_API_KEY=

# Cookie-based admin dashboard auth (not Supabase Auth).
ADMIN_PASSWORD=
