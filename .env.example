# Copy to .env.local and fill in. Never commit .env.local.
# Values marked PUBLIC are inlined into the browser bundle at build time — no secrets there.

# ── Booking ───────────────────────────────────────────────────────────────────
# PUBLIC. The Calendly event URL behind every "Book a consultation" CTA on the site.
# Must be an https://calendly.com/... URL. The build FAILS LOUDLY if this is missing or
# malformed — that is deliberate, it used to render data-url="undefined" in production.
# Must also be set in the Vercel project environment variables for every environment
# (Production, Preview, Development), because Next.js inlines it at build time.
NEXT_PUBLIC_CALENDLY_LINK=https://calendly.com/ajmalconsults/free-business-clarity-consultation

# ── Site ──────────────────────────────────────────────────────────────────────
# PUBLIC. Canonical origin. Used by the proxy origin allowlist and the admin logout redirect.
NEXT_PUBLIC_SITE_URL=https://www.muhammedajmal.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# PUBLIC. Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC. Publishable (anon) key — safe in the browser, constrained by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET. Service role key — bypasses RLS. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# SECRET.
RESEND_API_KEY=
# The verified sender address. Also receives contact-form notifications.
RESEND_FROM_EMAIL=

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
# SECRET. Generates the diagnostic action plan.
ANTHROPIC_API_KEY=

# ── Admin dashboard ───────────────────────────────────────────────────────────
# SECRET. Cookie-based admin auth (not Supabase Auth). Use a long random string.
ADMIN_PASSWORD=

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# Rate limiting works out of the box using the Supabase `rate_limits` table — no
# configuration needed. If you later create a free Upstash Redis database, set both
# variables below and the limiter switches to Redis automatically. Leave blank otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics (optional) ──────────────────────────────────────────────────────
# PUBLIC. Google Analytics measurement ID (G-XXXXXXXXXX). Leave blank to disable GA.
# Vercel Analytics needs no key — enable it in the Vercel dashboard.
NEXT_PUBLIC_GA_ID=
